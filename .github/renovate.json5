{
    extends: ['github>coveo/renovate-presets', 'github>coveo/renovate-presets//auto-merge.json'],
    semanticCommitScope: 'deps',
    commitBody: 'UITOOL-284',
    packageRules: [
        {
            description: 'Use the chore commit type for minor and patch-level updates',
            matchUpdateTypes: ['minor', 'patch'],
            semanticCommitType: 'chore',
        },
        {
            description: 'Major updates can contain breaking changes, so a human reviews and merges them',
            matchUpdateTypes: ['major'],
            automerge: false,
        },
        {
            groupName: '@tanstack table',
            description: 'Group major updates of @tanstack packages together because they need to be updated at the same time',
            matchUpdateTypes: ['major'],
            matchPackageNames: ['@tanstack/{/,}**'],
        },
        {
            groupName: 'ui-kit',
            description: 'Group major updates of ui-kit packages together because they need to be updated at the same time',
            matchUpdateTypes: ['major'],
            matchPackageNames: ['@coveo/atomic-react{/,}**', '@coveo/headless{/,}**'],
        },
    ],
    lockFileMaintenance: {
        description: 'Regenerate the pnpm-lock.yaml file',
        enabled: true,
        extends: ['schedule:weekly'],
    },
}
